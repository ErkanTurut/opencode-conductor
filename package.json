{
  "name": "opencode-conductor",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc-contract.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "types": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "assets",
    "dist/gui-experimental.cjs",
    "config",
    "schemas",
    "profiles",
    "docs",
    "scripts",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun && vite build",
    "gui:build": "vite build",
    "gui:watch": "vite build --watch",
    "smoke:gui": "node scripts/gui-smoke.cjs",
    "typecheck": "bun run scripts/typecheck-baseline.ts",
    "typecheck:raw": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "supervisor:run": "bun run src/cli.ts run",
    "supervisor:resume": "bun run src/cli.ts resume",
    "fleet-ui": "bun run src/fleet-ui/server.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
