{
  "_comment": "ADDITIVE OVERRIDES over the canonical root 'opencode.json' permission block. The root file is the single permission authority for OpenCode itself; this profile only adds supervisor-policy rules consumed by the plugin's fail-closed shell gate and MCP scope check. Keys starting with '_' are ignored by the loader.",
  "name": "Assisted Profile",
  "description": "Human approves plan and mutation batches. Low-risk implementation and validation automated.",
  "operation_mode": "assisted",
  "policy_profile": "assisted",
  "risk_class_limit": "medium",
  "data_class_limit": "internal",
  "model_overrides": {},
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "src/**", "effect": "allow" },
    { "action": "edit", "resource": "tests/**", "effect": "allow" },
    { "action": "edit", "resource": "packages/**", "effect": "allow" },
    { "action": "edit", "resource": "docs/**", "effect": "allow" },
    { "action": "edit", "resource": ".opencode/**", "effect": "allow" },
    { "action": "edit", "resource": "**/*.config.*", "effect": "ask" },
    { "action": "edit", "resource": "**/package.json", "effect": "ask" },
    { "action": "edit", "resource": "**/schema.ts", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push origin develop *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "sudo **", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "bun install *", "effect": "ask" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" }
  ],
  "_comment_mcp_profiles": "Human-present mode (plan/merge/deploy gates): retains the full documented server set, so the MCP scope gate never narrows an assisted session. Narrowing applies to the unattended/observe profiles.",
  "mcp_profiles": ["core-readonly", "document", "cloud-readonly", "cloud-mutation", "compliance", "data", "payments", "messaging", "dns"],
  "human_gates": ["plan_approval", "merge_approval", "deploy_approval"],
  "budget": {
    "max_concurrent_mutating_tasks": 2,
    "max_concurrent_scouts": 4,
    "max_attempts_per_task": 2,
    "max_repair_rounds": 3,
    "max_task_wall_time_ms": 1200000,
    "max_run_wall_time_ms": 7200000,
    "unattended_merge_enabled": false
  },
  "validation_commands": [
    "bun run format",
    "bun run lint",
    "bun run test",
    "bun run build"
  ]
}
