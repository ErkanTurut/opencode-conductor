{
  "_comment": "ADDITIVE OVERRIDES over the canonical root 'opencode.json' permission block. The root file is the single permission authority for OpenCode itself; this profile only adds supervisor-policy rules consumed by the plugin's fail-closed shell gate and MCP scope check. NOTE: operation_mode 'unattended' makes the hook deny mutating shell commands with no matching rule. Keys starting with '_' are ignored by the loader.",
  "name": "Unattended Low-Risk Profile",
  "description": "No human present. Only pre-approved low-risk issue classes. Strict budgets. No merge, no deploy.",
  "operation_mode": "unattended",
  "policy_profile": "unattended-low-risk",
  "risk_class_limit": "low",
  "data_class_limit": "internal",
  "allowed_issue_labels": ["bug", "test", "docs", "refactor"],
  "model_overrides": {},
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "src/**", "effect": "allow" },
    { "action": "edit", "resource": "tests/**", "effect": "allow" },
    { "action": "edit", "resource": "docs/**", "effect": "allow" },
    { "action": "edit", "resource": "**/*.config.*", "effect": "ask" },
    { "action": "edit", "resource": "**/package.json", "effect": "deny" },
    { "action": "edit", "resource": "**/schema.ts", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo **", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "bun install *", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" },
    { "action": "subagent", "resource": "conductor", "effect": "allow" },
    { "action": "subagent", "resource": "scout", "effect": "allow" },
    { "action": "subagent", "resource": "coder", "effect": "allow" },
    { "action": "subagent", "resource": "test-engineer", "effect": "allow" },
    { "action": "subagent", "resource": "critic", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "_comment_mcp_profiles": "Unattended: repository tooling only. No MCP server is reachable (core-readonly expands to none).",
  "mcp_profiles": ["core-readonly"],
  "human_gates": ["merge_approval", "deploy_approval"],
  "budget": {
    "max_concurrent_mutating_tasks": 1,
    "max_concurrent_scouts": 2,
    "max_attempts_per_task": 2,
    "max_repair_rounds": 2,
    "max_task_wall_time_ms": 600000,
    "max_run_wall_time_ms": 3600000,
    "unattended_merge_enabled": false
  },
  "validation_commands": [
    "bun run format",
    "bun run lint",
    "bun run test"
  ]
}
