{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-supervisor/schemas/review.schema.json",
  "$comment": "review_id convention (interface-only, no FK): a finding is run-scoped when review_id is exactly the run id ({runId}) or carries a round marker ({runId}:round-{N}). Receipt/ledger aggregation matches the exact id OR the `{runId}:%` prefix. This note is documentation only; the status enum is unchanged (open, accepted, rejected, fixed, wont_fix).",
  "title": "Review Finding",
  "type": "object",
  "required": ["severity", "category", "title", "fingerprint", "evidence"],
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "category": {
      "type": "string",
      "enum": [
        "correctness", "performance", "security", "style",
        "architecture", "testing", "documentation",
        "accessibility", "dependencies", "other"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "location": {
      "type": "string",
      "description": "file:line reference"
    },
    "evidence": { "type": "string", "minLength": 1 },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "blocking": { "type": "boolean", "default": false },
    "required_fix": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "accepted", "rejected", "fixed", "wont_fix"],
      "default": "open"
    }
  }
}
