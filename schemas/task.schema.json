{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-supervisor/schemas/task.schema.json",
  "title": "Task Contract",
  "type": "object",
  "required": ["task_id", "run_id", "role", "objective", "acceptance_criteria"],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "role": {
      "type": "string",
      "enum": [
        "conductor", "scout", "external-scout", "architect",
        "coder", "frontend-specialist", "test-engineer",
        "build-verifier", "critic", "security-critic",
        "integrator", "memory-curator"
      ]
    },
    "model_slot": {
      "type": "string",
      "enum": ["fast-triage", "architecture", "implementation", "ui-visual", "testing", "critique", "security", "integration"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string" },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "read_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "must_not": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priority": { "type": "integer", "default": 0 },
    "model_provider": { "type": "string" },
    "model_id": { "type": "string" },
    "mcp_profile": { "type": "string" }
  }
}
